---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
---

<Base title={title} description={description}>
  <section class="section">
    <div class="wrap legal">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: title, href: path }]} />
      <h1>{title}</h1>
      <slot />
    </div>
  </section>
</Base>

<style>
  .legal {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  .legal :global(h2) {
    font-size: clamp(1.7rem, 4.4vw, 2rem);
    margin-top: 2rem;
  }
  .legal :global(.todo) {
    background: var(--sun);
    padding: 0 0.25em;
    border-radius: 2px;
  }
</style>

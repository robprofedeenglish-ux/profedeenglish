---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { PRICES, SITE, skoolLink } from '../config';
import { breadcrumbs } from '../lib/schema';
import recursos from '../data/recursos.json';
import { existsSync } from 'node:fs';

// Los PDF se generan con recursos-fuente/build.py, que también actualiza src/data/recursos.json.
const categories = [
  { id: 'examenes', label: 'Exámenes' },
  { id: 'gramatica', label: 'Gramática' },
  { id: 'vocabulario', label: 'Vocabulario' },
  { id: 'pronunciacion', label: 'Pronunciación' },
  { id: 'series-y-peliculas', label: 'Series y películas' },
  { id: 'ia', label: 'Practicar con IA' },
  { id: 'plan', label: 'Plan de estudio' },
];

// El recurso con "featured": true sale el primero, arriba del todo (es al que llevan los enlaces de Instagram).
// Para destacar otro, quita featured del anterior y pónselo al nuevo; si tiene portada en /descargas/portadas/{slug}.jpg, se muestra.
const featured = recursos.find((r) => r.featured);
const featuredCover = featured && existsSync(`public/descargas/portadas/${featured.slug}.jpg`) ? `/descargas/portadas/${featured.slug}.jpg` : null;

const groups = categories
  .map((c) => ({ ...c, items: recursos.filter((r) => r.category === c.id && r !== featured) }))
  .filter((g) => g.items.length > 0);

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Recursos', href: '/recursos' },
];

const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: `${SITE.url}/recursos`,
  name: 'Recursos gratis para aprender inglés',
  inLanguage: 'es',
  hasPart: recursos.map((r) => ({
    '@type': 'DigitalDocument',
    name: r.title,
    description: r.description,
    url: `${SITE.url}${r.file}`,
    encodingFormat: 'application/pdf',
    isAccessibleForFree: true,
  })),
};
---

<Base
  title="Recursos gratis para aprender inglés"
  description="Guías y chuletas en PDF para aprender inglés: gramática, vocabulario, pronunciación, series y películas por niveles. Gratis y sin dejar tu correo."
  schema={[collection, breadcrumbs(crumbs)]}
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Recursos gratis</h1>

      {
        featured && (
          <article class="feat" id={featured.slug} aria-labelledby="feat-title">
            {featuredCover && (
              <a class="feat__cover" href={featured.file} type="application/pdf" tabindex="-1" aria-hidden="true">
                <img src={featuredCover} width="496" height="702" alt="" />
              </a>
            )}
            <div class="feat__head">
              <p class="feat__tag">La guía de Instagram</p>
              <h2 id="feat-title">{featured.title}</h2>
              <p class="res__meta">PDF · {featured.pages} páginas · Gratis</p>
            </div>
            <a class="btn btn--primary feat__btn" href={featured.file} type="application/pdf">
              Descargar la guía<span class="sr-only"> {featured.title}</span>
            </a>
            <p class="feat__desc">{featured.description}</p>
          </article>
        )
      }
      <a class="reto-card" href="/reto">
        <span class="badge">Reto gratis · 5 días</span>
        <span class="reto-card__title">Deja de bloquearte en inglés en 5 días</span>
        <span class="reto-card__desc">Unos 10 minutos al día para descubrir qué te bloquea y qué hacer cuando te quedas en blanco, con el freeze tracker y la escalera para hablar.</span>
        <span class="reto-card__go">Empezar el reto</span>
      </a>
      <p class="lede">
        Estas son las guías y chuletas que he ido preparando para mis alumnos y para Instagram, todas en PDF. Descárgalas, imprímelas o guárdalas
        en el móvil, sin registrarte ni dejar tu correo.
      </p>

      <nav class="jump" aria-label="Categorías">
        {groups.map((g) => <a href={`#${g.id}`}>{g.label}</a>)}
      </nav>

      {
        groups.map((g) => (
          <section class="group" id={g.id} aria-labelledby={`h-${g.id}`}>
            <h2 id={`h-${g.id}`}>{g.label}</h2>
            <ul class="list" role="list">
              {g.items.map((r) => (
                <li class="card res" id={r.slug}>
                  <span class="badge">{r.level}</span>
                  <h3>{r.title}</h3>
                  <p>{r.description}</p>
                  <p class="res__meta">
                    PDF · {r.pages} {r.pages === 1 ? 'página' : 'páginas'} · {r.sizeKb} KB
                  </p>
                  <a class="btn btn--ghost btn--small" href={r.file} type="application/pdf">
                    Descargar<span class="sr-only"> {r.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section section--navy end">
    <div class="wrap end__inner">
      <h2>Deja de bloquearte en 90 días</h2>
      <p>
        Las guías te ayudan a entender el inglés, pero soltarte a hablar llega cuando lo usas con gente de verdad. En la comunidad hablas cada
        semana con nativos y conmigo, y sin darte cuenta ya llevas horas hablando en inglés.
      </p>
      <a class="btn btn--primary" href={skoolLink('recursos', 'final')}>Empieza tus 90 días</a>
      <p class="microcopy">Desde {PRICES.standardMonth} $ al mes más impuestos, y cancelas desde Skool cuando quieras.</p>
    </div>
  </section>
</Base>

<style>
  .feat {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    grid-template-areas: 'cover head' 'btn btn' 'desc desc';
    gap: 1rem;
    align-items: center;
    margin: 1rem 0 2.5rem;
    padding: 1rem;
    background: var(--white);
    border: var(--outline-thick);
    border-radius: 18px;
    outline: 5px solid var(--sun);
    scroll-margin-top: 1rem;
  }
  .feat__cover {
    grid-area: cover;
    display: block;
  }
  .feat__cover img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--outline);
    border-radius: 6px;
  }
  .feat__head {
    grid-area: head;
  }
  .feat__tag {
    display: inline-block;
    margin: 0 0 0.4rem;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--sun);
    border: var(--outline);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
  }
  .feat h2 {
    margin: 0 0 0.3rem;
    font-size: 1.7rem;
    line-height: 1.1;
  }
  .feat__head .res__meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--navy-soft);
  }
  .feat__btn {
    grid-area: btn;
    justify-self: stretch;
    text-align: center;
  }
  .feat__desc {
    grid-area: desc;
    margin: 0;
    font-size: 0.98rem;
  }
  @media (min-width: 46rem) {
    .feat {
      grid-template-columns: 12rem 1fr;
      grid-template-areas: 'cover head' 'cover desc' 'cover btn';
      grid-template-rows: auto auto auto;
      align-items: start;
      column-gap: 2rem;
      row-gap: 0.8rem;
      padding: 1.75rem;
    }
    .feat h2 {
      font-size: 2.2rem;
    }
    .feat__btn {
      justify-self: start;
    }
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 1rem;
  }
  .jump a {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy);
    text-decoration: none;
    border: var(--outline);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    background: var(--white);
  }
  .jump a:hover {
    background: var(--sun);
  }
  .group {
    margin-top: 3rem;
    scroll-margin-top: 1rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
  }
  .res {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--white);
  }
  .res {
    scroll-margin-top: 1.5rem;
  }
  .res:target {
    outline: 4px solid var(--sun);
    outline-offset: 4px;
  }
  .res h3 {
    margin-top: 0.8rem;
    color: var(--navy);
  }
  .res p {
    font-size: 0.98rem;
  }
  .res__meta {
    margin-top: auto;
    font-size: 0.85rem !important;
    color: var(--navy-soft);
  }
  .end h2 {
    color: var(--sun);
  }
  .end__inner {
    max-width: 46rem;
  }
  .end .microcopy {
    color: var(--cream);
  }

  .reto-card {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    margin: 0 0 2rem;
    padding: 1.25rem;
    background: var(--white);
    border: var(--outline-thick);
    border-radius: 18px;
    color: var(--navy);
    text-decoration: none;
  }
  .reto-card:hover {
    background: var(--cream);
  }
  .reto-card__title {
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--sea);
  }
  .reto-card__desc {
    font-size: 0.98rem;
  }
  .reto-card__go {
    font-weight: 700;
    color: var(--sea);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
</style>

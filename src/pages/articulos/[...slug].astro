---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import Photo from '../../components/Photo.astro';
import { render } from 'astro:content';
import { getArticles, CATEGORIES, fmtDate } from '../../lib/articles';
import { breadcrumbs, person, orgId, personId } from '../../lib/schema';
import { PRICES, SITE, skoolLink } from '../../config';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: articles.filter((a) => a.id !== entry.id && a.data.category === entry.data.category).slice(0, 3) },
  }));
}

const { entry, related } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const slug = entry.id;
const url = `${SITE.url}/articulos/${slug}`;
const updated = data.updated ?? data.published;
const h2s = headings.filter((h) => h.depth === 2);
const showToc = h2s.length >= 4;

const endAsk = {
  info: {
    title: 'Leerlo ayuda, pero lo que te quita el bloqueo es hablar',
    text: 'En mi comunidad practicas cada semana con clases en directo e intercambios con nativos, con un plan de 90 días que se adapta a ti, y empiezas a hablar desde el primer día.',
  },
  compra: {
    title: 'Si lo que buscas es un sitio donde hablar cada semana',
    text: 'Real English With Rob es mi comunidad: un reto de 90 días para dejar de bloquearte, intercambios con nativos, una clase en directo a la semana conmigo y más de 100 horas de material, desde 23 $ al mes.',
  },
  examen: {
    title: 'Prepara el speaking hablando, no solo leyendo modelos',
    text: 'Con Premium lo preparamos 1 a 1, con un plan hecho para tu examen, ya sea la EOI, Aptis o Cambridge, y corrección según los criterios oficiales de evaluación.',
  },
}[data.intent];

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Artículos', href: '/articulos' },
  { label: data.title, href: `/articulos/${slug}` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: 'es',
  datePublished: data.published.toISOString(),
  dateModified: updated.toISOString(),
  mainEntityOfPage: url,
  author: person,
  publisher: { '@id': orgId },
  ...(data.youtubeId ? { image: `https://i.ytimg.com/vi/${data.youtubeId}/hqdefault.jpg` } : {}),
};
---

<Base title={data.title} description={data.description} type="article" schema={[articleSchema, breadcrumbs(crumbs)]}>
  <article class="article">
    <div class="wrap article__wrap">
      <Breadcrumbs items={crumbs.slice(0, 2)} />
      <p class="article__cat"><span class="badge">{CATEGORIES[data.category]}</span></p>
      <h1>{data.title}</h1>

      <div class="byline">
        <Photo src="/fotos/rob-avatar.jpg" alt="Rob" class="byline__photo" />
        <p>
          Por <a href="/sobre-mi" rel="author">Rob Tyson</a>, profesor británico de inglés para hispanohablantes<br />
          <span>Actualizado el <time datetime={updated.toISOString()}>{fmtDate(updated)}</time></span>
        </p>
      </div>

      {
        data.comparison && (
          <p class="disclosure">
            Para que lo tengas claro desde el principio: soy el creador de Real English With Rob, una de las opciones que menciono. Los precios y datos
            de otras empresas son los que vi en sus webs en la fecha de actualización de este artículo.
          </p>
        )
      }

      {data.videoFirst && data.youtubeId && <div class="article__video"><LiteYouTube id={data.youtubeId} title={data.videoTitle ?? data.title} /></div>}

      <div class="short-answer">
        <p class="short-answer__label">Respuesta corta</p>
        <p>{data.shortAnswer}</p>
      </div>

      {!data.videoFirst && data.youtubeId && <div class="article__video"><LiteYouTube id={data.youtubeId} title={data.videoTitle ?? data.title} /></div>}

      <p class="ask-top">
        ¿Prefieres trabajarlo hablando conmigo y con más gente?
        <a href={skoolLink('articulo', 'top_box', slug)}>Empieza tus 90 días en la comunidad</a>.
      </p>

      {
        showToc && (
          <details class="toc">
            <summary>En este artículo</summary>
            <ol>
              {h2s.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        data.exercise && (
          <section class="exercise" aria-labelledby="ejercicio">
            <h2 id="ejercicio">Tu ejercicio de esta semana</h2>
            <p>{data.exercise}</p>
          </section>
        )
      }

      {
        data.faq.length > 0 && (
          <section class="faq article__faq" aria-labelledby="preguntas">
            <h2 id="preguntas">Preguntas frecuentes</h2>
            {data.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )
      }

      <aside class="end-ask">
        <h2>{endAsk.title}</h2>
        <p>{endAsk.text}</p>
        <a class="btn end-ask__btn" href={skoolLink('articulo', 'final', slug)}>Empieza tus 90 días</a>
        <p class="end-ask__micro">Desde {PRICES.standardMonth} $ al mes más impuestos, y puedes cancelar desde Skool cuando quieras.</p>
      </aside>

      <section class="author" aria-label="Sobre el autor">
        <Photo src="/fotos/rob-avatar.jpg" alt="Rob" class="author__photo" />
        <div>
          <p class="author__name">Rob Tyson</p>
          <p>
            Profesor británico con certificado TEFL y casi diez años de experiencia enseñando a hispanohablantes. Vive en España, aprendió
            español por inmersión y escribe sus propios materiales. En Instagram es <a href={SITE.instagram} rel="me noopener">@profedeenglish_</a>.
          </p>
        </div>
      </section>

      {
        related.length > 0 && (
          <nav class="related" aria-label="Artículos relacionados">
            <h2>Sigue leyendo</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={`/articulos/${r.id}`}>{r.data.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </article>
</Base>

<style>
  .article {
    padding: clamp(2rem, 6vw, 4rem) 0 clamp(3rem, 8vw, 6rem);
  }
  .article__wrap {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  .article__cat {
    margin-bottom: 0.9rem;
  }
  .article h1 {
    font-size: clamp(2.1rem, 6.4vw, 3.3rem);
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.25rem 0 2rem;
    font-size: 0.93rem;
    line-height: 1.45;
  }
  .byline p {
    margin: 0;
  }
  .byline a {
    font-weight: 700;
  }
  .byline span {
    color: var(--navy-soft);
  }
  :global(.byline__photo) {
    width: 3.4rem;
    height: 3.4rem;
    aspect-ratio: 1;
    border-radius: 50% !important;
    border-width: 2px !important;
    flex: none;
    font-size: 0.75rem;
    padding: 0;
  }

  .disclosure {
    font-size: 0.93rem;
    border: 2px dashed var(--navy);
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
  }

  .short-answer {
    position: relative;
    border: var(--outline-thick);
    border-radius: var(--radius);
    padding: 1.6rem 1.3rem 1.2rem;
    margin: 1.4rem 0 1.75rem;
  }
  .short-answer__label {
    position: absolute;
    top: 0;
    left: 1rem;
    transform: translateY(-50%);
    margin: 0;
    background: var(--sun);
    color: var(--navy);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.2;
    padding: 0.3rem 0.8rem;
    border: var(--outline);
    border-radius: 999px;
  }
  .short-answer p:last-child {
    margin: 0;
  }

  .article__video {
    margin: 0 0 1.75rem;
  }

  .ask-top {
    font-size: 0.97rem;
    padding: 0.9rem 0;
    border-top: var(--outline);
    border-bottom: var(--outline);
    margin-bottom: 2rem;
  }
  .ask-top a {
    font-weight: 700;
  }

  .toc {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border: var(--outline);
    border-radius: var(--radius);
  }
  .toc summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--navy);
  }
  .toc ol {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  /* Article body */
  .prose :global(h2) {
    margin-top: 2.1em;
    font-size: clamp(1.75rem, 4.6vw, 2.2rem);
  }
  .prose :global(h3) {
    margin-top: 1.6em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--coral);
  }
  .prose :global(strong) {
    color: var(--navy);
  }
  /* English examples: a blockquote (>) becomes a postcard-style example card */
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem 1rem 1.5rem;
    background: var(--cream);
    border: var(--outline);
    border-left: 8px solid var(--sea-light);
    border-radius: var(--radius);
  }
  .prose :global(blockquote p:last-child) {
    margin: 0;
  }
  /* The English sentence (bold) sits on its own line with the Spanish below */
  .prose :global(blockquote p > strong:first-child) {
    display: block;
    font-size: 1.05em;
    color: var(--sea);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
    border: var(--outline);
    border-radius: var(--radius);
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--navy);
    vertical-align: top;
  }
  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(th) {
    background: var(--navy);
    color: var(--cream);
  }

  /* Mid-article box (inserted by src/lib/rehype-mid-cta.mjs) */
  .prose :global(.cta-mid) {
    margin: 2.5rem 0;
    padding: 1.6rem 1.5rem;
    background: var(--sea);
    color: var(--white);
    border: var(--outline-thick);
    border-radius: var(--radius);
  }
  .prose :global(.cta-mid__title) {
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.25;
    color: var(--white);
    margin-bottom: 0.5rem;
  }
  .prose :global(.cta-mid .btn) {
    background: var(--coral);
    color: var(--white);
    border-color: var(--navy);
  }
  .prose :global(.cta-mid .btn:hover) {
    background: #c9432d;
  }
  .prose :global(.cta-mid .microcopy) {
    color: var(--cream);
    margin-bottom: 0;
  }
  .prose :global(.cta-mid__action) {
    margin: 1.25rem 0 0;
  }

  .exercise {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border: 3px dashed var(--navy);
    border-radius: var(--radius);
  }
  .exercise h2 {
    font-size: clamp(1.6rem, 4.4vw, 2rem);
  }
  .exercise p {
    margin: 0;
  }

  .article__faq {
    margin: 2.5rem 0;
  }
  .article__faq h2 {
    margin-bottom: 0.6rem;
  }

  .end-ask {
    margin: 3rem 0;
    padding: 2rem 1.75rem;
    background: var(--navy);
    color: var(--cream);
    border-radius: var(--radius);
  }
  .end-ask h2 {
    font-size: clamp(1.75rem, 4.6vw, 2.2rem);
  }
  .end-ask__btn {
    background: var(--coral);
    color: var(--white);
    border-color: var(--cream);
    margin-top: 0.5rem;
  }
  .end-ask__btn:hover {
    background: #c9432d;
    color: var(--white);
  }
  .end-ask__micro {
    font-size: 0.875rem;
    color: var(--cream);
    margin: 0.75rem 0 0;
  }

  .author {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    border: var(--outline);
    border-radius: var(--radius);
  }
  :global(.author__photo) {
    width: 5rem;
    height: 5rem;
    aspect-ratio: 1;
    border-radius: 50% !important;
    border-width: 2px !important;
    flex: none;
    font-size: 0.8rem;
    padding: 0;
  }
  .author__name {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }
  .author p:last-child {
    margin: 0;
  }

  .related {
    margin-top: 2.5rem;
  }
  .related h2 {
    font-size: clamp(1.75rem, 4.6vw, 2.1rem);
  }
  .related ul {
    padding-left: 1.2rem;
  }
  .related li {
    margin-bottom: 0.5rem;
  }
  .related li::marker {
    color: var(--coral);
  }
</style>

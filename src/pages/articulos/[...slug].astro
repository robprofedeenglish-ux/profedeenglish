---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import Photo from '../../components/Photo.astro';
import { render } from 'astro:content';
import { getArticles, CATEGORIES, fmtDate } from '../../lib/articles';
import { breadcrumbs, person, orgId, personId } from '../../lib/schema';
import { PRICES, SITE, skoolLink } from '../../config';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: articles.filter((a) => a.id !== entry.id && a.data.category === entry.data.category).slice(0, 3) },
  }));
}

const { entry, related } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const slug = entry.id;
const url = `${SITE.url}/articulos/${slug}`;
const updated = data.updated ?? data.published;
const h2s = headings.filter((h) => h.depth === 2);
const showToc = h2s.length >= 4;

const endAsk = {
  info: {
    title: 'Leerlo ayuda, pero lo que te quita el bloqueo es hablar',
    text: 'En mi comunidad practicas cada semana con clases en directo, un compañero de práctica e intercambios con nativos, y empiezas a hablar desde el primer día de la prueba.',
  },
  compra: {
    title: 'Si lo que buscas es un sitio donde hablar cada semana',
    text: 'Real English With Rob es mi comunidad: clases de conversación en directo, compañero de práctica, intercambios con nativos y un plan para dejar de bloquearte, con 7 días gratis para que veas si te encaja.',
  },
  examen: {
    title: 'Prepara el speaking hablando, no solo leyendo modelos',
    text: 'En Premium preparamos el speaking de la EOI, Aptis y Cambridge con práctica en directo y corrección según los criterios oficiales de evaluación.',
  },
}[data.intent];

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Artículos', href: '/articulos' },
  { label: data.title, href: `/articulos/${slug}` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: 'es',
  datePublished: data.published.toISOString(),
  dateModified: updated.toISOString(),
  mainEntityOfPage: url,
  author: person,
  publisher: { '@id': orgId },
  ...(data.youtubeId ? { image: `https://i.ytimg.com/vi/${data.youtubeId}/hqdefault.jpg` } : {}),
};
---

<Base title={data.title} description={data.description} type="article" schema={[articleSchema, breadcrumbs(crumbs)]}>
  <article class="article">
    <div class="wrap article__wrap">
      <Breadcrumbs items={crumbs.slice(0, 2)} />
      <p class="article__cat">{CATEGORIES[data.category]}</p>
      <h1>{data.title}</h1>

      <div class="byline">
        <Photo alt="Rob" class="byline__photo" label="Rob" />
        <p>
          Por <a href="/sobre-mi" rel="author">Rob Tyson</a>, profesor británico de inglés para hispanohablantes<br />
          <span>Actualizado el <time datetime={updated.toISOString()}>{fmtDate(updated)}</time></span>
        </p>
      </div>

      {
        data.comparison && (
          <p class="disclosure">
            Para que lo tengas claro desde el principio: soy el creador de Real English With Rob, una de las opciones que menciono. Los precios y datos
            de otras empresas son los que vi en sus webs en la fecha de actualización de este artículo.
          </p>
        )
      }

      {data.videoFirst && data.youtubeId && <div class="article__video"><LiteYouTube id={data.youtubeId} title={data.videoTitle ?? data.title} /></div>}

      <div class="short-answer">
        <p class="short-answer__label">Respuesta corta</p>
        <p>{data.shortAnswer}</p>
      </div>

      {!data.videoFirst && data.youtubeId && <div class="article__video"><LiteYouTube id={data.youtubeId} title={data.videoTitle ?? data.title} /></div>}

      <p class="ask-top">
        ¿Prefieres trabajarlo hablando conmigo y con más gente?
        <a href={skoolLink('articulo', 'top_box', slug)}>Prueba la comunidad {PRICES.trialDays} días gratis</a>.
      </p>

      {
        showToc && (
          <details class="toc">
            <summary>En este artículo</summary>
            <ol>
              {h2s.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        data.exercise && (
          <section class="exercise" aria-labelledby="ejercicio">
            <h2 id="ejercicio">Tu ejercicio de esta semana</h2>
            <p>{data.exercise}</p>
          </section>
        )
      }

      {
        data.faq.length > 0 && (
          <section class="faq article__faq" aria-labelledby="preguntas">
            <h2 id="preguntas">Preguntas frecuentes</h2>
            {data.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )
      }

      <aside class="end-ask">
        <h2>{endAsk.title}</h2>
        <p>{endAsk.text}</p>
        <a class="btn end-ask__btn" href={skoolLink('articulo', 'final', slug)}>Prueba {PRICES.trialDays} días gratis</a>
        <p class="end-ask__micro">Después, desde {PRICES.standardMonth} $ al mes, y puedes cancelar desde Skool cuando quieras.</p>
      </aside>

      <section class="author" aria-label="Sobre el autor">
        <Photo alt="Rob" class="author__photo" label="Rob" />
        <div>
          <p class="author__name">Rob Tyson</p>
          <p>
            Profesor británico con unos diez años de experiencia enseñando a hispanohablantes. Vive en España, aprendió español por inmersión y
            escribe sus propios materiales. En Instagram es <a href={SITE.instagram} rel="me noopener">@profedeenglish_</a>.
          </p>
        </div>
      </section>

      {
        related.length > 0 && (
          <nav class="related" aria-label="Artículos relacionados">
            <h2>Sigue leyendo</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={`/articulos/${r.id}`}>{r.data.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </article>
</Base>

<style>
  .article {
    padding: clamp(2rem, 6vw, 4rem) 0 clamp(3rem, 8vw, 6rem);
  }
  .article__wrap {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  .article__cat {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .article h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.2rem);
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.25rem 0 2rem;
    font-size: 0.93rem;
    line-height: 1.45;
  }
  .byline p {
    margin: 0;
  }
  .byline span {
    color: var(--muted);
  }
  :global(.byline__photo) {
    width: 3.25rem;
    height: 3.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    flex: none;
    font-size: 0.75rem;
    padding: 0;
  }

  .disclosure {
    font-size: 0.93rem;
    background: var(--sheet);
    border: 1px solid var(--rule);
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-s);
  }

  .short-answer {
    border-left: 4px solid var(--mustard);
    background: var(--sheet);
    padding: 1.1rem 1.3rem;
    margin: 0 0 1.75rem;
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .short-answer__label {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--wine);
    margin: 0 0 0.3rem;
  }
  .short-answer p:last-child {
    margin: 0;
  }

  .article__video {
    margin: 0 0 1.75rem;
  }

  .ask-top {
    font-size: 0.97rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2rem;
  }

  .toc {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
  }
  .toc summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--wine);
  }
  .toc ol {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  /* Cuerpo del artículo */
  .prose :global(h2) {
    margin-top: 2.2em;
  }
  .prose :global(h3) {
    margin-top: 1.6em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--wine-2);
  }
  .prose :global(strong) {
    color: var(--wine);
  }
  /* Ejemplos en inglés: en Markdown, una cita (>) se convierte en caja de ejemplo */
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: #fff;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--wine);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .prose :global(blockquote p:last-child) {
    margin: 0;
  }
  /* La frase en inglés (en negrita) va en su línea y la traducción debajo */
  .prose :global(blockquote p > strong:first-child) {
    display: block;
    font-size: 1.05em;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--wine);
  }

  /* Caja a mitad de artículo (la inserta src/lib/rehype-mid-cta.mjs) */
  .prose :global(.cta-mid) {
    margin: 2.5rem 0;
    padding: 1.5rem;
    background: var(--wine);
    color: #f1e7d6;
    border-radius: var(--radius-m);
  }
  .prose :global(.cta-mid__title) {
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--paper);
    margin-bottom: 0.5rem;
  }
  .prose :global(.cta-mid .btn) {
    background: var(--mustard);
    color: var(--wine);
  }
  .prose :global(.cta-mid .microcopy) {
    color: #d8c9b1;
    margin-bottom: 0;
  }
  .prose :global(.cta-mid__action) {
    margin: 1.25rem 0 0;
  }

  .exercise {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border: 2px dashed var(--mustard);
    border-radius: var(--radius-m);
  }
  .exercise h2 {
    font-size: 1.5rem;
  }
  .exercise p {
    margin: 0;
  }

  .article__faq {
    margin: 2.5rem 0;
  }
  .article__faq h2 {
    margin-bottom: 0.25rem;
  }

  .end-ask {
    margin: 3rem 0;
    padding: 2rem 1.75rem;
    background: var(--wine);
    color: #f1e7d6;
    border-radius: var(--radius-m);
  }
  .end-ask h2 {
    color: var(--paper);
    font-size: clamp(1.6rem, 3.4vw, 2rem);
  }
  .end-ask__btn {
    background: var(--mustard);
    color: var(--wine);
    margin-top: 0.5rem;
  }
  .end-ask__btn:hover {
    background: #e0b85c;
    color: var(--wine);
  }
  .end-ask__micro {
    font-size: 0.875rem;
    color: #d8c9b1;
    margin: 0.75rem 0 0;
  }

  .author {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  :global(.author__photo) {
    width: 5rem;
    height: 5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    flex: none;
    font-size: 0.8rem;
    padding: 0;
  }
  .author__name {
    font-family: var(--serif);
    font-size: 1.35rem;
    color: var(--wine);
    margin-bottom: 0.25rem;
  }
  .author p:last-child {
    margin: 0;
  }

  .related {
    margin-top: 2.5rem;
  }
  .related h2 {
    font-size: 1.6rem;
  }
  .related ul {
    padding-left: 1.2rem;
  }
  .related li {
    margin-bottom: 0.5rem;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getArticles, CATEGORIES, fmtDate } from '../../lib/articles';
import { breadcrumbs } from '../../lib/schema';
import { SITE } from '../../config';

const articles = await getArticles();
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Artículos', href: '/articulos' },
];
---

<Base
  title="Artículos para hablar inglés sin bloquearte"
  description="Artículos de Rob, profesor británico, para hispanohablantes que entienden inglés pero se bloquean al hablar, además de guías de speaking para la EOI y Aptis."
  schema={[breadcrumbs(crumbs)]}
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Artículos</h1>
      <p class="lede">
        Lo que veo en clase cada semana, explicado para que lo puedas poner en práctica: cómo dejar de bloquearte, cómo preparar el speaking de la EOI
        y Aptis, y qué apps y clases te sirven de verdad para hablar.
      </p>

      {
        articles.length === 0 ? (
          <p class="empty">
            Estoy escribiendo los primeros artículos. Mientras tanto, tienes vídeos nuevos cada semana en{' '}
            <a href={SITE.instagram} rel="noopener">
              mi Instagram
            </a>
            .
          </p>
        ) : (
          <ul class="list">
            {articles.map((a) => (
              <li>
                <span class="list__cat">{CATEGORIES[a.data.category]}</span>
                <a href={`/articulos/${a.id}`}>{a.data.title}</a>
                <p>{a.data.description}</p>
                <time datetime={a.data.published.toISOString()}>{fmtDate(a.data.published)}</time>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .lede {
    max-width: 52ch;
    margin-bottom: 3rem;
  }
  .empty {
    max-width: 52ch;
    padding: 1.5rem;
    border: var(--outline);
    border-radius: var(--radius);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
    display: grid;
    gap: 1.25rem;
  }
  .list li {
    padding: 1.4rem 1.5rem;
    border: var(--outline);
    border-radius: var(--radius);
  }
  .list__cat {
    display: inline-block;
    background: var(--sun);
    color: var(--navy);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    border: var(--outline);
    margin-bottom: 0.6rem;
  }
  .list a {
    display: block;
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--navy);
    text-decoration: none;
  }
  .list a:hover {
    color: var(--sea);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .list p {
    margin: 0.4rem 0;
  }
  .list time {
    font-size: 0.875rem;
    color: var(--navy-soft);
  }
</style>

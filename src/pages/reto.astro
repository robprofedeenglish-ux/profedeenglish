    align-items: center;
    gap: 0.9rem;
    border: var(--outline);
    border-radius: 10px;
    padding: 0.6rem 0.9rem;
    background: var(--cream);
  }
  .escalera li:nth-child(2) { margin-left: 0.75rem; }
  .escalera li:nth-child(3) { margin-left: 1.5rem; }
  .escalera li:nth-child(4) { margin-left: 2.25rem; background: var(--sun); }
  .escalera li:nth-child(5) { margin-left: 3rem; background: var(--sun); }
  .escalera__n {
    flex-shrink: 0;
    font-family: var(--display);
    font-size: 1.4rem;
    line-height: 1;
    width: 1.6rem;
    text-align: center;
  }
  .escalera b {
    display: block;
    line-height: 1.3;
  }
  .escalera__w {
    display: block;
    font-size: 0.92rem;
  }
  .end h2 {
    color: var(--sun);
  }
  .end__banner {
    display: block;
    margin: 1.5rem 0;
  }
  .end__banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 3px solid var(--cream);
  }
  .end .microcopy {
    color: var(--cream);
  }
</style>

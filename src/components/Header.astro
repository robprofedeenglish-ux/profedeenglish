---
import { skoolLink } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/articulos', label: 'Artículos' },
  { href: '/test-de-nivel', label: 'Test de nivel' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/opiniones', label: 'Opiniones' },
  { href: '/#precios', label: 'Precios' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="wordmark" aria-label="Profe de English, inicio">
      <img class="wordmark__mark" src="/logo-r.png" alt="" width="44" height="44" />
      <span class="wordmark__text">
        <span class="wordmark__name">Profe de English</span>
        <span class="wordmark__sub">Real English With Rob</span>
      </span>
    </a>
    <nav aria-label="Principal" class="site-nav">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) && l.href !== '/#precios' ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn--primary btn--small header-cta" href={skoolLink('header', 'header')}>Empieza tus 90 días</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--cream);
    border-bottom: var(--outline);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-right: auto;
  }
  .wordmark__mark {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: var(--outline);
  }
  .wordmark__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .wordmark__name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--navy);
  }
  .wordmark__sub {
    font-size: 0.78rem;
    color: var(--navy-soft);
  }
  .site-nav {
    display: flex;
    gap: 1.5rem;
  }
  .site-nav a {
    color: var(--navy);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--sea);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  /* Below desktop width the menu drops to its own row under the logo and scrolls sideways,
     so phones can still reach every section (the test de nivel link sits near the start). */
  @media (max-width: 64rem) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: 0.4rem;
    }
    .site-nav {
      order: 3;
      width: 100%;
      gap: 1.25rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0.15rem 0 0.1rem;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav a {
      white-space: nowrap;
      font-size: 0.95rem;
      padding: 0.35rem 0;
    }
  }
  /* On phones the R mark stands in for the name so the button keeps its accessible size */
  @media (max-width: 30rem) {
    .wordmark__text {
      display: none;
    }
    .site-header__inner {
      gap: 0.75rem;
    }
  }
</style>

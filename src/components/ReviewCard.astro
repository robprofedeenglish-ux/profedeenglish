---
import { monthsLabel } from '../data/opiniones';
interface Props {
  name: string;
  months: number;
  lang: string;
  text: string;
}
const { name, months, lang, text } = Astro.props;
---

<figure class="review">
  <p class="review__stars" aria-label="5 de 5 estrellas">★★★★★</p>
  <blockquote lang={lang}>
    <p>{text}</p>
  </blockquote>
  <figcaption>
    <span class="review__name">{name}</span>
    <span class="review__meta">{monthsLabel(months)}</span>
  </figcaption>
</figure>

<style>
  .review {
    margin: 0;
    padding: 1.5rem;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    display: flex;
    flex-direction: column;
  }
  .review__stars {
    color: var(--mustard);
    letter-spacing: 0.15em;
    margin: 0 0 0.6rem;
    font-size: 1rem;
  }
  blockquote {
    margin: 0 0 1rem;
    flex: 1;
  }
  blockquote p {
    margin: 0;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
  }
  .review__name {
    font-weight: 600;
    color: var(--wine);
  }
  .review__meta {
    color: var(--muted);
  }
</style>

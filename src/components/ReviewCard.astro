---
import { monthsLabel } from '../data/opiniones';
interface Props {
  name: string;
  months: number;
  lang: string;
  text: string;
}
const { name, months, lang, text } = Astro.props;
---

<figure class="review">
  <p class="review__stars" aria-label="5 de 5 estrellas">★★★★★</p>
  <blockquote lang={lang}>
    <p>{text}</p>
  </blockquote>
  <figcaption>
    <span class="review__name">{name}</span>
    <span class="review__meta">{monthsLabel(months)}</span>
  </figcaption>
</figure>

<style>
  .review {
    margin: 0;
    padding: 1.5rem;
    background: var(--cream);
    border: var(--outline);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
  }
  .review__stars {
    align-self: flex-start;
    background: var(--navy);
    color: var(--sun);
    letter-spacing: 0.12em;
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0.4rem 0.7rem 0.45rem;
    border-radius: 999px;
  }
  blockquote {
    margin: 0 0 1rem;
    flex: 1;
  }
  blockquote p {
    margin: 0;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
    padding-top: 0.9rem;
    border-top: 2px dashed var(--navy);
  }
  .review__name {
    font-weight: 700;
    color: var(--navy);
  }
  .review__meta {
    color: var(--navy-soft);
  }
</style>

---
// Vídeo de YouTube que solo se carga cuando la persona pulsa.
// - La miniatura se descarga al compilar y va incrustada en la página, así que al abrir
//   el artículo no se hace ninguna petición a YouTube ni a Google.
// - Al pulsar se carga youtube-nocookie.com; el aviso debajo del vídeo lo explica,
//   y ese clic es la decisión de la persona de cargar YouTube.
interface Props {
  id: string;
  title: string;
  short?: boolean;
}
const { id, title, short = false } = Astro.props;

let poster: string | null = null;
try {
  const res = await fetch(`https://i.ytimg.com/vi/${id}/hqdefault.jpg`, { signal: AbortSignal.timeout(8000) });
  if (res.ok) poster = `data:image/jpeg;base64,${Buffer.from(await res.arrayBuffer()).toString('base64')}`;
} catch {
  poster = null; // sin red al compilar: se muestra el botón sin miniatura
}
---

<div class="lite-yt-wrap">
  <button
    type="button"
    class:list={['lite-yt', { 'lite-yt--short': short }]}
    data-yt={id}
    data-title={title}
    style={poster ? `background-image:url(${poster})` : undefined}
    aria-label={`Ver el vídeo: ${title}`}
  >
    <span class="lite-yt__play" aria-hidden="true"></span>
  </button>
  <p class="lite-yt__note">Al pulsar, el vídeo se carga desde YouTube, que a partir de ese momento puede usar cookies. <a href="/cookies">Más información</a>.</p>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.lite-yt').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
        iframe.title = btn.dataset.title || 'Vídeo';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        btn.replaceChildren(iframe);
        iframe.focus();
      },
      { once: true }
    );
  });
</script>

<style>
  .lite-yt__note {
    font-size: 0.8rem;
    color: var(--navy-soft);
    margin: 0.5rem 0 0;
  }
</style>
